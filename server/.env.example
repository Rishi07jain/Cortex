# Copy this file to .env and fill in real values
# 5001, not 5000 - macOS's AirPlay Receiver (AirTunes) owns port 5000.
PORT=5001
NODE_ENV=development

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/investigative-canvas
# Or MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/investigative-canvas?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=30d

# Where the Next.js client runs (used for CORS). Comma-separate for multiple origins.
CLIENT_URL=http://localhost:3000
